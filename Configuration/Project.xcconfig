// Set your team in Xcode or in Developer.xcconfig. All targets inherit these identifiers.
DT_BUNDLE_PREFIX = com.tyh24647.DevTools
DT_APP_GROUP = group.com.tyh24647.DevTools
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
IPHONEOS_DEPLOYMENT_TARGET = 17.5
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = targeted
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
// Google's official test IDs. Replace all four for production monetization.
DT_ADMOB_APP_ID = ca-app-pub-3940256099942544~1458002511
DT_BANNER_AD_ID = ca-app-pub-3940256099942544/2934735716
DT_INTERSTITIAL_AD_ID = ca-app-pub-3940256099942544/4411468910
DT_APP_OPEN_AD_ID = ca-app-pub-3940256099942544/5575463023

// Default bundle identifiers for all targets
PRODUCT_BUNDLE_IDENTIFIER = $(DT_BUNDLE_PREFIX)

// Child targets append suffixes; targets can override in their own xcconfig if needed
PRODUCT_BUNDLE_IDENTIFIER[sdk=iphoneos*][arch=*] = $(DT_BUNDLE_PREFIX)

// Per-target overrides via conditional assignment by configuration names used in the generator
// Main app
PRODUCT_BUNDLE_IDENTIFIER[config=Debug] = $(DT_BUNDLE_PREFIX)
PRODUCT_BUNDLE_IDENTIFIER[config=Release] = $(DT_BUNDLE_PREFIX)

// Safari Web Extension container
DEVTOOLS_SAFARI_BUNDLE_ID = $(DT_BUNDLE_PREFIX).Safari
// Action extensions
DEVTOOLS_ADD_BLACKLIST_BUNDLE_ID = $(DT_BUNDLE_PREFIX).AddBlacklist
DEVTOOLS_ADD_ALLOWLIST_BUNDLE_ID = $(DT_BUNDLE_PREFIX).AddAllowList
DEVTOOLS_SHOW_BUNDLE_ID = $(DT_BUNDLE_PREFIX).Show
DEVTOOLS_HIDE_BUNDLE_ID = $(DT_BUNDLE_PREFIX).Hide
DEVTOOLS_ENABLE_BUNDLE_ID = $(DT_BUNDLE_PREFIX).Enable
DEVTOOLS_DISABLE_BUNDLE_ID = $(DT_BUNDLE_PREFIX).Disable

// Expose App Group to Info.plist via user-defined setting
DevToolsAppGroup = $(DT_APP_GROUP)

// AdMob IDs mapped to the names used in code or Info.plist if applicable
GADApplicationIdentifier = $(DT_ADMOB_APP_ID)

#include? "Developer.xcconfig"
